# Server Configuration
PORT=8080
ENVIRONMENT=development

# Security
# Secrets MUST be at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
SESSION_DURATION=336h
CSRF_SECRET=your-csrf-secret-here-generate-with-openssl-rand-base64-32

# Cross-origin access (optional). Comma-separated list of origins allowed to
# make credentialed cross-origin requests. Leave empty for same-origin only
# (recommended). Example: https://tracker.example.com
ALLOWED_ORIGINS=

# Reverse-proxy trust (optional). Comma-separated CIDRs/IPs of trusted proxies
# whose X-Forwarded-For / X-Real-IP headers may be used for client IP / rate
# limiting. Leave empty to ignore forwarding headers (use the direct peer).
# Behind nginx/Caddy in Docker this is typically the proxy's container subnet,
# e.g. 172.16.0.0/12
TRUSTED_PROXIES=

# Database
DATABASE_PATH=./data/tracker.db

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=15m

# SMTP (Optional)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# Security Headers
CSP_ENABLED=true
HSTS_ENABLED=true